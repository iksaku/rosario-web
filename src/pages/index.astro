---
import "../styles/global.css";

// PROTOTYPE branch (wayfinder ticket #30): index.astro renders the variant
// switcher island instead of the handbook layout. The canonical layout is
// preserved on main and restored when the winner is folded in.
import PrototypeRoot from "../components/prototype/PrototypeRoot";
---

<html lang="es">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="generator" content={Astro.generator} />

	<title>Guía del Santo Rosario — Prototipos</title>
	<meta name="description" content="Guía web para rezar del Santo Rosario en cualquier lugar." />
	<meta name="robots" content="noindex" />
</head>
	<body class="bg-white dark:bg-stone-950 text-black dark:text-white">
		<PrototypeRoot client:only="solid-js" />
		<prototype-switcher></prototype-switcher>
		<script src="../components/prototype/switcher.ts"></script>
	</body>
</html>
